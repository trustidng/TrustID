DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trustid

# Ed25519 signing configuration (Phase 6) — never commit the private value
TRUSTID_SIGNING_KEY_ID=dev-2026-01
TRUSTID_SIGNING_PRIVATE_KEY_B64=
PUBLIC_BASE_URL=http://127.0.0.1:8000

# HMAC secret for org-scoped pseudonyms (Phase 1 §6) — never commit the actual value
PSEUDONYM_HMAC_SECRET=change-me-to-a-random-32-byte-secret

# Phase 2 authentication. Generate each secret independently with:
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-different-random-32-byte-secret
SESSION_TTL_HOURS=12
OTP_TTL_MINUTES=10
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
USSD_SESSION_TTL_MINUTES=3

COOKIE_SECURE=false
